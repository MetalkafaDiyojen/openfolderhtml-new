ng="" class="style-scope ytd-text-inline-expander" disable-upgrade="" hidden=""></yt-formatted-string></span><span class="style-scope ytd-text-inline-expander">&nbsp;</span><span id="ellipsis" class="style-scope ytd-text-inline-expander">…</span><tp-yt-paper-button id="expand-sizer" class="button style-scope ytd-text-inline-expander" style-target="host" role="button" tabindex="0" animated="" elevation="0" aria-disabled="false"><!--css-build:shady--><!--css_build_scope:tp-yt-paper-button--><!--css_build_styles:video.youtube.src.web.polymer.shared.ui.styles.yt_base_styles.yt.base.styles.css.js,third_party.javascript.youtube_components.tp_yt_paper_button.tp.yt.paper.button.css.js-->...daha fazla
