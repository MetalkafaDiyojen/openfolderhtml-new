          <yt-formatted-string class="metadata-snippet-text-navigation style-scope ytd-video-renderer"><span dir="auto" class="style-scope yt-formatted-string">Using data from the Hubble Space Telescope, scientists have developed this </span><span dir="auto" class="bold style-scope yt-formatted-string" style-target="bold">simulation</span><span dir="auto" class="style-scope yt-formatted-string"> of the head-on </span><span dir="auto" class="bold style-scope yt-formatted-string" style-target="bold">collision</span><span dir="auto" class="style-scope yt-formatted-string"> of our </span><span dir="auto" class="bold style-scope yt-formatted-string" style-target="bold">Milky Way</span><span dir="auto" class="style-scope yt-formatted-string">&nbsp;...</span></yt-formatted-string>
        </a>
        <yt-formatted-string class="metadata-snippet-text style-scope ytd-video-renderer"><span dir="auto" class="style-scope yt-formatted-string">Using data from the Hubble Space Telescope, scientists have developed this </span><span dir="auto" class="bold style-scope yt-formatted-string" style-target="bold">simulation</span><span dir="auto" class="style-scope yt-formatted-string"> of the head-on </span><span dir="auto" class="bold style-scope yt-formatted-string" style-target="bold">collision</span><span dir="auto" class="style-scope yt-formatted-string"> of our </span><span dir="auto" class="bold style-scope yt-formatted-string" style-target="bold">Milky Way</span><span dir="auto" class="style-scope yt-formatted-string">&nbsp;...</span></yt-formatted-string>
