":"https://yt3.googleusercontent.com/UV1rzy-DB-V_5a8itvaT4F_knnYDikenwQtuQhwA3Jxbs3BaoraJmW1lKUuK56pLEmhOjqMe=w2120-fcrop64=1,00005a57ffffa5a8-k-c0xffffffff-no-nd-rj","width":2120,"height":351},{"url":"https://yt3.googleusercontent.com/UV1rzy-DB-V_5a8itvaT4F_knnYDikenwQtuQhwA3Jxbs3BaoraJmW1lKUuK56pLEmhOjqMe=w2276-fcrop64=1,00005a57ffffa5a8-k-c0xffffffff-no-nd-rj","width":2276,"height":377},{"url":"https://yt3.googleusercontent.com/UV1rzy-DB-V_5a8itvaT4F_knnYDikenwQtuQhwA3Jxbs3BaoraJmW1lKUuK56pLEmhOjqMe=w2560-fcrop64=1,00005a57ffffa5a8-k-c0xffffffff-no-nd-rj","width":2560,"height":424}]},"style":"IMAGE_BANNER_STYLE_INSET","rendererContext":{"loggingContext":{"loggingDirectives":{"trackingParams":"CBkQnfILIhMIzYuLl_HflwMVWRkeBR0fkDkg","visibility":{"types":"12"}}}}}},"rendererContext":{"loggingContext":{"loggingDirectives":{"trackingParams":"CBgQot8KIhMIzYuLl_HflwMVWRkeBR0fkDkg","visibility":{"types":"12"}}}}}}}},"metadata":{"channelMetadataRenderer":{"title":"NASA Video","description":"NASA's mission is to pioneer the future in space exploration, scientific discovery and aeronautics research. To do that, thousands of people have been working around the world and in space for more than 50 years, trying to answer some basic questions. What's out there in space? How do we get there? What will we find? What can we learn there -- or learn just by trying to get there -- that will make life better here on Earth?\r\n\r\nNASA's work is diverse: proving flight technologies; creating capabilities for sustainable human and robotic exploration; exploring Earth, the solar system and the universe beyond; developing critical enabling technologies such as the space shuttle; and conducting science in orbit aboard the International Space Station. With NASA you can explore the universe and discover Earth.","rssUrl":"https://www.youtube.com/feeds/videos.xml?channel_id=UC_aP7p621ATY_yAa8jMqUVA","externalId":"UC_aP7p621ATY_yAa8jMqUVA","keywords":"","ownerUrls":["http://www.youtube.com/@NAS