<div id="microformat" class="style-scope ytd-watch-flexy"><player-microformat-renderer class="playerMicroformatRendererHost"><script type="application/ld+json" nonce="LExI-eic7gKBl6f3nVknIw">{"@context":"https://schema.org","@type":"VideoObject","description":"This animation depicts the collision between our Milky Way galaxy and the Andromeda galaxy. Hubble Space Telescope observations indicate that the two galaxies, pulled together by their mutual gravity, will crash together about 4 billion years from now. Around 6 billion years from now, the two galaxies will merge to form a single galaxy. The video also shows the Triangulum galaxy, which will join in the collision and perhaps later merge with the Andromeda/Milky Way pair.         \n           \nVisualization Credit: NASA, ESA, and F. Summers (STScI)           \nSimulation Credit: NASA, ESA, G. Besla (Columbia University), and            \nR. van der Marel (STScI)","duration":"PT77S","embedUrl":"https://www.youtube.com/embed/fMNlt2FnHDg","name":"Milky Way's Head On Collision","thumbnailUrl":["https://i.ytimg.com/vi/fMNlt2FnHDg/maxresdefault.jpg?sqp=-oaymwEmCIAKENAF8quKqQMa8AEB-AH-CYAC0AWKAgwIABABGDwgSyh_MA8=&rs=AOn4CLDtBhXklbAzyG1duyRSVaqptzw4Xw"],"uploadDate":"2013-05-24T13:16:44-07:00","@id":"https://www.youtube.com/watch?v=fMNlt2FnHDg","interactionStatistic":[{"@type":"InteractionCounter","interactionType":"https://schema.org/WatchAction","userInteractionCount":"568425"},{"@type":"InteractionCounter","interactionType":"https://schema.org/LikeAction","userInteractionCount":"2033"}],"genre":"Science & Technology","author":"NASA Video"}</script></player-microformat-renderer></div>

