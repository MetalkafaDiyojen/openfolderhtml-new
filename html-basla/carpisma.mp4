          <yt-page-header-renderer class="pageHeaderRendererHost style-scope ytd-tabbed-page-header"><yt-page-header-view-model class="ytPageHeaderViewModelHost ytPageHeaderViewModelNoPadding"><div class="ytPageHeaderViewModelContent"><div class="ytPageHeaderViewModelHeadline"><yt-decorated-avatar-view-model class="ytDecoratedAvatarViewModelHost ytPageHeaderViewModelHeadlineImage"><yt-avatar-shape><div class="ytSpecAvatarShapeHost ytSpecAvatarShapeButton ytSpecAvatarShapeButtonGiant" aria-label=""><div class=""><div class="ytSpecAvatarShapeAvatarSizeGiant"><img class="ytCoreImageHost ytSpecAvatarShapeImage ytCoreImageFillParentHeight ytCoreImageFillParentWidth ytCoreImageContentModeScaleToFill ytCoreImageLoaded" alt="" src="./carpisma_files/unnamed(1).jpg"><div class="ytSpecAvatarShapeImageOverlays ytSpecAvatarShapeImage"></div></div></div></div></yt-avatar-shape></yt-decorated-avatar-view-model><div class="ytPageHeaderViewModelHeadlineInfo"><yt-dynamic-text-view-model class="ytPageHeaderViewModelTitle ytPageHeaderViewModelTitleLarge dynamicTextViewModelHost"><h1 class="dynamicTextViewModelH1" aria-label=""><span class="ytAttributedStringHost ytAttributedStringWhiteSpacePreWrap" dir="auto" role="text" style="">NASA Video</span></h1></yt-dynamic-text-view-model><yt-content-metadata-view-model class="ytPageHeaderViewModelContentMetadata ytContentMetadataViewModelHost ytContentMetadataViewModelInline ytContentMetadataViewModelMediumText"><div class="ytContentMetadataViewModelMetadataRow ytContentMetadataViewModelMetadataRowInline" role="group"><span class="ytAttributedStringHost ytContentMetadataViewModelMetadataText ytContentMetadataViewModelMetadataTextLastPart ytAttributedStringWhiteSpacePreWrap ytAttributedStringLinkInheritColor" dir="auto" role="text"><span class="ytAttributedStringLinkInheritColor" dir="auto" style="font-weight: 500; color: rgb(19, 19, 19);">@NASAgovVideo</span></span></div><span aria-hidden="true" class="ytContentMetadataViewModelDelimiter ytContentMetadataViewModelDelimiterStandalone">•</span><div class="ytContentMetadataViewModelMetadataRow ytContentMetadataViewModelMetadataRowInline" role="group"><span class="ytAttributedStringHost ytContentMetadataViewModelMetadataText ytAttributedStringWhiteSpacePreWrap ytAttributedStringLinkInheritColor" dir="auto" aria-label="1,07 milyon abone" role="text">1,07&nbsp;Mn abone</span><span aria-hidden="true" class="ytContentMetadataViewModelDelimiter">•</span><span class="ytAttributedStringHost ytContentMetadataViewModelMetadataText ytContentMetadataViewModelMetadataTextLastPart ytAttributedStringWhiteSpacePreWrap ytAttributedStringLinkInheritColor" dir="auto" role="text"><span class="" dir="auto" style="">10&nbsp;B video</span></span></div></yt-content-metadata-view-model><yt-description-preview-view-model class="ytDescriptionPreviewViewModelHost ytPageHeaderViewModelDescription ytDescriptionPreviewViewModelClickable"><truncated-text class="ytTruncatedTextHost ytTruncatedTextMediumText" style="line-height: 2rem; overflow: hidden;"><truncated-text-content class="ytTruncatedTextTruncatedTextContent" style="max-height: 2rem;"><span class="ytAttributedStringHost ytAttributedStringWhiteSpacePreWrap" role="text" style="">NASA's mission is to pioneer the future in space exploration, scientific discovery and aeronautics research. To do that, thousands of people have been working around the world and in space for more than 50 years, trying to answer some basic questions. What's out there in space? How do we get there? What will we find? What can we learn there -- or learn just by trying to get there -- that will make life better here on Earth? </span><button aria-disabled="true" disabled="true" class="ytTruncatedTextInlineButton" style="line-height: 2rem;"><span class="ytAttributedStringHost ytAttributedStringWhiteSpacePreWrap" role="text" style=""><span class="" style="font-weight: 500;">...devamı</span></span></button></truncated-text-content><truncated-text-content class="ytTruncatedTextTruncatedTextContent ytTruncatedTextHiddenTextContent" aria-hidden="true" style="max-height: 2rem;"><span class="ytAttributedStringHost ytAttributedStringWhiteSpacePreWrap" role="text" style="">NASA's mission is to pioneer the future in space exploration, scientific discovery and aeronautics research. To do that, thousands of people have been working around the world and in space for more than 50 years, trying to answer some basic questions. What's out there in space? How do we get there? What will we find? What can we learn there -- or learn just by trying to get there -- that will make life better here on Earth? </span><button aria-disabled="true" disabled="true" class="ytTruncatedTextInlineButton" style="line-height: 2rem;"><span class="ytAttributedStringHost ytAttributedStringWhiteSpacePreWrap" role="text" style=""><span class="" style="font-weight: 500;">...devamı</span></span></button></truncated-text-content><button aria-label="Açıklama. NASA&#39;s mission is to pioneer the future in space exploration... Daha fazlası için dokunun." class="ytTruncatedTextAbsoluteButton" style="line-height: 2rem; right: unset; left: 0px;"><span class="ytAttributedStringHost ytAttributedStringWhiteSpacePreWrap" role="text" style=""><span class="" style="font-weight: 500;">...devamı</span></span></button></truncated-text></yt-description-preview-view-model><yt-attribution-view-model class="ytPageHeaderViewModelAttribution ytAttributionViewModelHost ytAttributionViewModelMediumText"><span class="ytAttributionViewModelAttributionText"><span><span class="ytAttributedStringHost ytAttributedStringWhiteSpaceNoWrap ytAttributedStringLinkInheritColor" style=""><span class="ytAttributedStringLinkInheritColor" style="font-weight: 400; color: rgb(6, 95, 212);"><a class="ytAttributedStringLink ytAttributedStringLinkCallToActionColor ytAttributedStringLinkInheritColor" href="https://www.youtube.com/redirect?event=channel_header&amp;redir_token=QUlxb01IWTFmLXJtVW5yTlZlYnN6VUF2UzB